# Sistema y entornos
.DS_Store
.venv/
# Sin barra final: también cubre los enlaces simbólicos que crean los worktrees
.venv
__pycache__/
*.pyc
logs/

# Secretos (NO publicar). Los endpoints de las fuentes de clima viven en clima/privado/
privado
*.env
.env*
!*.env.ejemplo
privado/
*.db
*.db-*

# Geodatos: descargas crudas (pesadas, regenerables y con datos personales
# de fuentes oficiales: nombres y teléfonos de responsables). Ver geodatos/LEEME.md
geodatos/descargas/
geodatos/descargas

# Páginas públicas generadas (10_publicar_web.py, 19_estudios_web.py); se suben con servidores/publicar.sh
geodatos/publicar/
geodatos/export/galapagos-completo/
geodatos/export/galapagos-completo
geodatos/geoserver-local/
# Estado local del flujo incremental (scripts/flujo.py): hashes y registros de corridas
geodatos/.flujo/

# Estudios: rasters intermedios y descargas crudas de APIs (se regeneran con los scripts)
geodatos/estudios/**/*.tif
geodatos/estudios/*/datos/lluvias/crudo/
# Tormentas sintéticas: corridas individuales y pilas de rasters (se regeneran con 32_tormentas_sinteticas.py)
geodatos/estudios/tormentas/cache/

# Worktrees de equipos y agentes (ver CONTRIBUIR.md §5) por si se crean dentro
.worktrees/

# Curvas IDF: lluvia horaria de GAR por días (se regenera con 34_curvas_idf.py descargar)
geodatos/estudios/idf/cache/

# Teselas del DTM SGIAR para /mapas (36_teselas_dtm.py; las copia 10_publicar_web.py)
geodatos/teselas/

# Informes técnicos y textos de los estudios: solo en local, no se suben ni se publican (decisión del 5-nov-2026).
# Los datos de los estudios (geodatos/estudios/*/datos/) sí se versionan: alimentan las capas de /mapas.
informes/
geodatos/estudios/*/texto/
geodatos/estudios/*/figuras/
geodatos/estudios/*/*.pdf
geodatos/estudios/pendientes/
geodatos/estudios/PUBLICAR.md
