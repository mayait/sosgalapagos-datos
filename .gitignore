# Sistema y entornos
.DS_Store
.venv/
__pycache__/
*.pyc
logs/

# Secretos (NO publicar). Los endpoints de las fuentes de clima viven en clima/privado/
*.env
.env*
!*.env.ejemplo
privado/
*.db
*.db-*

# Geodatos: descargas crudas (pesadas, regenerables y con datos personales
# de fuentes oficiales: nombres y teléfonos de responsables). Ver geodatos/LEEME.md
geodatos/descargas/

# Páginas públicas generadas (10_publicar_web.py, 19_estudios_web.py); se suben con servidores/publicar.sh
geodatos/publicar/
geodatos/export/galapagos-completo/
geodatos/geoserver-local/

# Estudios: rasters intermedios y descargas crudas de APIs (se regeneran con los scripts)
geodatos/estudios/**/*.tif
geodatos/estudios/*/datos/lluvias/crudo/

# Worktrees de equipos y agentes (ver CONTRIBUIR.md §4) por si se crean dentro
.worktrees/
