# Copiar a privado/fuentes.env (no versionado) y completar con los endpoints de cada fuente.
# Los endpoints no se publican porque algunas fuentes aún no son públicas; pídelos al equipo.
# En el servidor, deploy/publicar.sh copia este archivo a /etc/sosgalapagos-clima/fuentes.env.
CLIMA_IERSE_API=
CLIMA_GSC_WS=
CLIMA_GSC_ORIGEN=
CLIMA_INAMHI_API=
CLIMA_IOC_API=
CLIMA_METAR_API=
CLIMA_WEATHERLINK_API=
CLIMA_WEATHERLINK_ESTACIONES=
CLIMA_TEMPEST_API=
CLIMA_TEMPEST_TOKEN=
CLIMA_TEMPEST_EQUIPOS=
# Ambient Weather: panel público compartido por el dueño; "clave_del_enlace:codigo[,…]"
CLIMA_AMBIENT_API=
CLIMA_AMBIENT_ESTACIONES=
# Weather Underground: raíz de la página pública de las estaciones; "id_de_la_estacion:codigo[,…]"
CLIMA_WU_PAGINA=
CLIMA_WU_ESTACIONES=
CLIMA_OPENMETEO_MARINE_API=
CLIMA_OPENMETEO_FORECAST_API=
CLIMA_OPENMETEO_PREVIOUS_API=
CLIMA_OPENMETEO_ENSEMBLE_API=
# GOES-19 (archivo abierto de NOAA en AWS, sin clave): raíz del bucket, sin barra final
CLIMA_GOES_S3=
CLIMA_ECMWF_S3=
