# Copiar a privado/fuentes.env (no versionado) y completar con los endpoints de cada fuente.
# Los endpoints no se publican porque algunas fuentes aún no son públicas; pídelos al equipo.
# En el servidor, deploy/publicar.sh copia este archivo a /etc/sosgalapagos-clima/fuentes.env.
CLIMA_IERSE_API=
CLIMA_GSC_WS=
CLIMA_GSC_ORIGEN=
CLIMA_INAMHI_API=
CLIMA_IOC_API=
CLIMA_METAR_API=
CLIMA_WEATHERLINK_API=
CLIMA_WEATHERLINK_ESTACIONES=
# Respaldo de Erna (CWOP DW5750): estaciones cercanas con la lluvia de la última hora, sin clave
CLIMA_RESPALDO_ERNA_API=
CLIMA_TEMPEST_API=
CLIMA_TEMPEST_TOKEN=
CLIMA_TEMPEST_EQUIPOS=
# Ambient Weather: panel público compartido por el dueño; "clave_del_enlace:codigo[,…]"
CLIMA_AMBIENT_API=
CLIMA_AMBIENT_ESTACIONES=
# Weather Underground: raíz de la página pública de las estaciones; "id_de_la_estacion:codigo[,…]"
CLIMA_WU_PAGINA=
CLIMA_WU_ESTACIONES=
CLIMA_OPENMETEO_MARINE_API=
CLIMA_OPENMETEO_FORECAST_API=
CLIMA_OPENMETEO_PREVIOUS_API=
CLIMA_OPENMETEO_ENSEMBLE_API=
# GOES-19 (archivo abierto de NOAA en AWS, sin clave): raíz del bucket, sin barra final
CLIMA_GOES_S3=
CLIMA_ECMWF_S3=
# El Niño y la ZCIT (los usa la plataforma: clima/nino.py y clima/zcit.py; y clima/scripts/10_nino_historico.py).
# NOAA CPC: archivos de texto del ONI, de los índices Niño semanales y mensuales, del calor de los 300 m y la discusión mensual de ENSO
CLIMA_CPC_ONI_URL=
CLIMA_CPC_SEMANAL_URL=
CLIMA_CPC_MENSUAL_URL=
CLIMA_CPC_CALOR_URL=
CLIMA_CPC_ENSO_URL=
# ERDDAP (griddap con el identificador del conjunto, sin extensión): Coral Reef Watch diario y mensual, OISST casi en tiempo real y final, nivel del mar por altimetría
CLIMA_CRW_ERDDAP=
CLIMA_CRW_MENSUAL_ERDDAP=
CLIMA_OISST_ERDDAP=
CLIMA_OISST_FINAL_ERDDAP=
CLIMA_SLA_ERDDAP=
# Boyas TAO: raíz «tabledap» del servidor ERDDAP, sin barra final
CLIMA_TAO_ERDDAP=
# NOAA PSL: índice ROMI de la MJO (texto)
CLIMA_MJO_URL=
# NHC: Tropical Weather Discussion del Pacífico este (texto plano)
CLIMA_NHC_TWD_URL=
