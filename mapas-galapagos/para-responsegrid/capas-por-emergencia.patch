diff --git a/apps/web/src/lib/map-layers/leaflet-layers.ts b/apps/web/src/lib/map-layers/leaflet-layers.ts
new file mode 100644
index 0000000..e75bf55
--- /dev/null
+++ b/apps/web/src/lib/map-layers/leaflet-layers.ts
@@ -0,0 +1,162 @@
+// Crea capas de Leaflet a partir del manifiesto de capas de una emergencia (ver ./manifest.ts).
+
+import L from 'leaflet';
+import {
+  classFor,
+  escapeHtml,
+  popupHtml,
+  resolveUrl,
+  styleFor,
+  type LayersManifest,
+  type ManifestLayer,
+  type Props,
+} from './manifest';
+
+export interface LayerContext {
+  /** URL base del paquete, terminada en «/» (p. ej. /capas/galapagos-2026/). */
+  base: string;
+  cache: Record<string, GeoJSON.FeatureCollection>;
+  limits?: Record<string, { bounds: L.LatLngBoundsExpression }>;
+  renderers: { areas: L.Renderer; lineas: L.Renderer; puntos: L.Renderer };
+}
+
+/** Panes en orden de apilado: raster < áreas rayadas < áreas < líneas < puntos (los marcadores de la app van en markerPane, 600). */
+const PANES: [string, number][] = [
+  ['rg-capas-fondo', 350],
+  ['rg-capas-patron', 390],
+  ['rg-capas-areas', 410],
+  ['rg-capas-lineas', 430],
+  ['rg-capas-puntos', 590],
+];
+
+export function capasBaseUrl(slug: string): string {
+  const root = process.env.NEXT_PUBLIC_CAPAS_BASE_URL ?? '/capas';
+  return `${root.replace(/\/$/, '')}/${encodeURIComponent(slug)}/`;
+}
+
+export async function loadManifest(base: string): Promise<LayersManifest | null> {
+  try {
+    const res = await fetch(resolveUrl(base, 'capas.json'), { cache: 'no-cache' });
+    if (!res.ok) return null;
+    const m = (await res.json()) as LayersManifest;
+    return Array.isArray(m?.grupos) ? m : null;
+  } catch {
+    return null;
+  }
+}
+
+export function prepareMap(map: L.Map, base: string): LayerContext {
+  for (const [name, z] of PANES) {
+    const pane = map.getPane(name) ?? map.createPane(name);
+    pane.style.zIndex = String(z);
+  }
+  map.getPane('rg-capas-fondo')!.style.pointerEvents = 'none';
+  return {
+    base,
+    cache: {},
+    renderers: {
+      areas: L.canvas({ pane: 'rg-capas-areas', padding: 0.3 }),
+      lineas: L.canvas({ pane: 'rg-capas-lineas', padding: 0.3 }),
+      puntos: L.canvas({ pane: 'rg-capas-puntos', padding: 0.3 }),
+    },
+  };
+}
+
+/** Renderer SVG con patrón de rayas; Leaflet pinta fill="url(#id)" y el navegador aplica el patrón. */
+function patternRenderer(pt: NonNullable<ManifestLayer['patron']>, pane: string): L.Renderer {
+  const r = L.svg({ pane });
+  r.on('add', () => {
+    const svg = (r as unknown as { _container?: SVGSVGElement })._container;
+    if (!svg || svg.querySelector(`#${pt.id}`)) return;
+    const s = pt.separacion ?? 8;
+    const defs = document.createElementNS('http://www.w3.org/2000/svg', 'defs');
+    defs.innerHTML =
+      `<pattern id="${escapeHtml(pt.id)}" patternUnits="userSpaceOnUse" width="${s}" height="${s}" patternTransform="rotate(45)">` +
+      `<rect width="${s}" height="${s}" fill="${escapeHtml(pt.fondo ?? 'none')}" fill-opacity="${pt.opacidad_fondo ?? 0}"/>` +
+      `<line x1="0" y1="0" x2="0" y2="${s}" stroke="${escapeHtml(pt.color)}" stroke-width="${pt.grosor ?? 1.5}" stroke-opacity="${pt.opacidad ?? 0.6}"/></pattern>`;
+    svg.insertBefore(defs, svg.firstChild);
+  });
+  return r;
+}
+
+/** Crea la capa de Leaflet de una entrada del manifiesto (descarga el archivo la primera vez). */
+export async function createLayer(layer: ManifestLayer, ctx: LayerContext): Promise<L.Layer> {
+  if (layer.tipo === 'raster') {
+    if (!ctx.limits) {
+      const res = await fetch(resolveUrl(ctx.base, 'raster/limites.json'), { cache: 'no-cache' });
+      ctx.limits = (await res.json()) as LayerContext['limits'];
+    }
+    return L.layerGroup(
+      Object.entries(ctx.limits ?? {}).map(([region, v]) =>
+        L.imageOverlay(resolveUrl(ctx.base, `raster/${region}_${layer.raster}.png`), v.bounds, {
+          opacity: layer.opacidad ?? 0.7,
+          pane: 'rg-capas-fondo',
+          className: layer.raster === 'relieve' ? 'rg-capas-multiply' : '',
+        }),
+      ),
+    );
+  }
+  const file = layer.archivo!;
+  if (!ctx.cache[file]) {
+    const res = await fetch(resolveUrl(ctx.base, file), { cache: 'no-cache' });
+    ctx.cache[file] = (await res.json()) as GeoJSON.FeatureCollection;
+  }
+  const data = ctx.cache[file]!;
+  const filter = layer.filtro
+    ? (f: GeoJSON.Feature) => layer.filtro!.en.includes(String((f.properties as Props | null)?.[layer.filtro!.propiedad]))
+    : undefined;
+  const key = layer.tipo === 'punto' ? 'puntos' : layer.tipo === 'linea' ? 'lineas' : 'areas';
+  const pane = layer.patron ? 'rg-capas-patron' : `rg-capas-${key}`;
+  const renderer = layer.patron ? patternRenderer(layer.patron, pane) : ctx.renderers[key];
+  const group = L.layerGroup();
+  if (layer.borde) {
+    const casing: L.GeoJSONOptions = { pane, interactive: false, style: () => ({ ...layer.borde, lineCap: 'round' }) };
+    if (filter) casing.filter = filter;
+    group.addLayer(L.geoJSON(data, { ...casing, renderer } as L.GeoJSONOptions));
+  }
+  const options: L.GeoJSONOptions = {
+    pane,
+    style: (f) => ({ lineCap: 'round', lineJoin: 'round', ...styleFor(layer, f?.properties as Props) }),
+    pointToLayer: (f, latlng) => {
+      const props = (f.properties ?? {}) as Props;
+      const s = styleFor(layer, props);
+      const cls = classFor(layer, props);
+      const risk = Boolean(props['en_susc_alta_media']);
+      if (cls?.simbolo) {
+        return L.marker(latlng, {
+          pane,
+          icon: L.divIcon({
+            className: '',
+            iconSize: [19, 19],
+            html: `<div style="width:19px;height:19px;border-radius:50%;background:${escapeHtml(s.fillColor)};color:#fff;font:800 11px/15px system-ui;text-align:center;border:2px solid #fff;box-shadow:${risk ? '0 0 0 3px #1d4a9e,' : ''}0 1px 4px rgba(0,0,0,.45)">${escapeHtml(cls.simbolo)}</div>`,
+          }),
+        });
+      }
+      const opts: L.CircleMarkerOptions = {
+        pane,
+        renderer,
+        radius: s.radius ?? 5,
+        color: risk ? '#1d4a9e' : '#fff',
+        weight: risk ? 2.5 : 1.3,
+        fillOpacity: 1,
+      };
+      if (s.fillColor) opts.fillColor = s.fillColor;
+      return L.circleMarker(latlng, opts);
+    },
+    onEachFeature: (f, l) => {
+      const props = (f.properties ?? {}) as Props;
+      l.bindPopup(() => popupHtml(layer, props));
+      const r = layer.rotulo;
+      const txt = r ? props[r.propiedad] : undefined;
+      if (r && txt != null && txt !== '') {
+        l.bindTooltip(
+          escapeHtml(txt) + escapeHtml(r.sufijo ?? ''),
+          r.permanente ? { permanent: true, direction: 'center', className: 'rg-capas-rotulo' } : { sticky: true },
+        );
+      }
+    },
+  };
+  if (filter) options.filter = filter;
+  group.addLayer(L.geoJSON(data, { ...options, renderer } as L.GeoJSONOptions));
+  return group;
+}
diff --git a/apps/web/src/lib/map-layers/manifest.test.ts b/apps/web/src/lib/map-layers/manifest.test.ts
new file mode 100644
index 0000000..fc12559
--- /dev/null
+++ b/apps/web/src/lib/map-layers/manifest.test.ts
@@ -0,0 +1,115 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  classFor,
+  styleFor,
+  legendFor,
+  popupHtml,
+  resolveUrl,
+  defaultVisibility,
+  isDrawable,
+  type ManifestLayer,
+  type LayersManifest,
+} from './manifest.ts';
+
+const susc: ManifestLayer = {
+  id: 'susc',
+  titulo: 'Susceptibilidad',
+  tipo: 'poligono',
+  estilo: { weight: 0.6, fillOpacity: 0.38 },
+  clasificar: {
+    propiedad: 'nivel',
+    valores: {
+      '1': { etiqueta: 'Baja', color: '#aaa', fillColor: '#bbb' },
+      '3': { etiqueta: 'Alta', color: '#111', fillColor: '#222', fillOpacity: 0.5 },
+    },
+    otro: { etiqueta: 'Otro', fillColor: '#999' },
+  },
+};
+
+test('classFor: valor exacto (número convertido a texto) y "otro" como respaldo', () => {
+  assert.equal(classFor(susc, { nivel: 3 })?.etiqueta, 'Alta');
+  assert.equal(classFor(susc, { nivel: '1' })?.etiqueta, 'Baja');
+  assert.equal(classFor(susc, { nivel: 7 })?.etiqueta, 'Otro');
+  assert.equal(classFor({ ...susc, clasificar: undefined }, { nivel: 3 }), null);
+});
+
+test('classFor: rangos por "hasta" inclusive', () => {
+  const pob: ManifestLayer = {
+    id: 'pob',
+    titulo: 'Población',
+    tipo: 'poligono',
+    clasificar: {
+      propiedad: 'p',
+      rangos: [
+        { hasta: 0, etiqueta: 'Sin dato' },
+        { hasta: 10, etiqueta: '1–10' },
+        { hasta: 1e9, etiqueta: '>10' },
+      ],
+    },
+  };
+  assert.equal(classFor(pob, { p: 0 })?.etiqueta, 'Sin dato');
+  assert.equal(classFor(pob, { p: 10 })?.etiqueta, '1–10');
+  assert.equal(classFor(pob, { p: 11 })?.etiqueta, '>10');
+  assert.equal(classFor(pob, {})?.etiqueta, 'Sin dato');
+});
+
+test('styleFor: mezcla base + clase sin campos de leyenda, y aplica estilo_si', () => {
+  const s = styleFor(susc, { nivel: 3 });
+  assert.deepEqual(s, { weight: 0.6, fillOpacity: 0.5, color: '#111', fillColor: '#222' });
+  const areas: ManifestLayer = {
+    ...susc,
+    estilo_si: [{ propiedad: 'estado', distinto_de: 'validada', estilo: { dashArray: '7 6' }, etiqueta: 'Por validar' }],
+  };
+  assert.equal(styleFor(areas, { nivel: 1, estado: 'por_validar' }).dashArray, '7 6');
+  assert.equal(styleFor(areas, { nivel: 1, estado: 'validada' }).dashArray, undefined);
+});
+
+test('legendFor: deriva de la clasificación y añade las reglas con etiqueta', () => {
+  const l = legendFor({ ...susc, estilo_si: [{ propiedad: 'e', igual_a: 1, estilo: { dashArray: '2 2' }, etiqueta: 'Regla' }] });
+  assert.deepEqual(
+    l.map((e) => [e.texto, e.color, e.forma]),
+    [
+      ['Baja', '#bbb', 'area'],
+      ['Alta', '#222', 'area'],
+      ['Otro', '#999', 'area'],
+      ['Regla', '#6b7280', 'linea'],
+    ],
+  );
+  const linea = legendFor({ id: 'q', titulo: 'Quebradas', tipo: 'linea', estilo: { color: '#00f', dashArray: '4 2' } });
+  assert.deepEqual(linea, [{ forma: 'linea', color: '#00f', texto: 'Quebradas', dash: '4 2' }]);
+  assert.deepEqual(legendFor({ ...susc, leyenda: [['#0f0', 'Parque']] }), [{ color: '#0f0', texto: 'Parque', forma: 'area' }]);
+});
+
+test('popupHtml: título, campos con etiqueta y escapado de HTML', () => {
+  const layer: ManifestLayer = {
+    ...susc,
+    popup: { titulo: 'nombre', titulo_defecto: 'Sin nombre', campos: { detalle: 'Detalle', ok: 'Validada', vacio: 'Vacío' } },
+  };
+  const h = popupHtml(layer, { nombre: '<b>La Cascada</b>', nivel: 3, detalle: 'Agua & lodo', ok: true, vacio: '' });
+  assert.match(h, /&lt;b&gt;La Cascada&lt;\/b&gt;/);
+  assert.match(h, /Alta · Susceptibilidad/);
+  assert.match(h, /Agua &amp; lodo/);
+  assert.match(h, /<td>Sí<\/td>/);
+  assert.doesNotMatch(h, /Vacío/);
+  assert.match(popupHtml(layer, { nivel: 1 }), /Sin nombre/);
+});
+
+test('resolveUrl: relativa a la base, salvo rutas absolutas', () => {
+  assert.equal(resolveUrl('/capas/x', 'a.geojson'), '/capas/x/a.geojson');
+  assert.equal(resolveUrl('/capas/x/', 'a.geojson'), '/capas/x/a.geojson');
+  assert.equal(resolveUrl('/capas/x/', '/otro/a.geojson'), '/otro/a.geojson');
+  assert.equal(resolveUrl('/capas/x/', 'https://cdn.example.org/a.geojson'), 'https://cdn.example.org/a.geojson');
+});
+
+test('defaultVisibility e isDrawable respetan visible y zoom_min', () => {
+  const m: LayersManifest = {
+    version: 2,
+    grupos: [{ id: 'g', titulo: 'G', capas: [{ ...susc, visible: true }, { ...susc, id: 'b', zoom_min: 15 }] }],
+  };
+  assert.deepEqual(defaultVisibility(m), { susc: true, b: false });
+  const b = m.grupos[0]!.capas[1]!;
+  assert.equal(isDrawable(b, true, 14), false);
+  assert.equal(isDrawable(b, true, 15), true);
+  assert.equal(isDrawable(b, false, 18), false);
+});
diff --git a/apps/web/src/lib/map-layers/manifest.ts b/apps/web/src/lib/map-layers/manifest.ts
new file mode 100644
index 0000000..15bca9b
--- /dev/null
+++ b/apps/web/src/lib/map-layers/manifest.ts
@@ -0,0 +1,207 @@
+// Capas cartográficas por emergencia: formato del manifiesto (capas.json) y lógica pura de estilos.
+//
+// Una emergencia puede publicar en `<CAPAS_BASE_URL>/<slug>/capas.json` un manifiesto con mapas base,
+// grupos de capas GeoJSON/raster, estilos de Leaflet, clasificaciones y leyendas. Este módulo no importa
+// Leaflet en tiempo de ejecución (solo tipos), así que se prueba con `node --test`.
+// La parte que crea capas de Leaflet está en ./leaflet-layers.ts. Especificación: docs/capas-emergencia.md.
+
+import type { LatLngBoundsExpression, PathOptions } from 'leaflet';
+
+export type Props = Record<string, unknown>;
+
+/** Opciones de estilo de Leaflet más los campos propios de una clase de leyenda. */
+export type LayerClass = PathOptions & {
+  etiqueta?: string;
+  /** Letra o símbolo dentro del marcador (solo capas de puntos). */
+  simbolo?: string;
+  radius?: number;
+  /** Solo en `rangos`: límite superior (inclusive) del rango. */
+  hasta?: number;
+};
+
+export interface StyleRule {
+  propiedad: string;
+  igual_a?: unknown;
+  distinto_de?: unknown;
+  estilo: PathOptions;
+  etiqueta?: string;
+}
+
+export interface ManifestLayer {
+  id: string;
+  titulo: string;
+  tipo: 'poligono' | 'linea' | 'punto' | 'raster';
+  /** Ruta relativa al manifiesto, o absoluta (/… o https://…). */
+  archivo?: string;
+  /** Solo raster: PNG `raster/<region>_<raster>.png`, con límites en `raster/limites.json`. */
+  raster?: string;
+  opacidad?: number;
+  visible?: boolean;
+  /** Por debajo de este zoom la capa no se dibuja (capas pesadas). */
+  zoom_min?: number;
+  fuente?: string;
+  descripcion?: string;
+  elementos?: number;
+  estilo?: PathOptions & { radius?: number };
+  /** Línea de contorno dibujada debajo (p. ej. borde blanco de las quebradas). */
+  borde?: PathOptions;
+  filtro?: { propiedad: string; en: string[] };
+  clasificar?: { propiedad: string; valores?: Record<string, LayerClass>; otro?: LayerClass; rangos?: LayerClass[] };
+  /** Reglas que se aplican encima de la clase (p. ej. línea discontinua si no está validada). */
+  estilo_si?: StyleRule[];
+  /** Etiqueta del elemento: al pasar el ratón, o permanente (visible desde zoom 15). */
+  rotulo?: { propiedad: string; permanente?: boolean; sufijo?: string };
+  popup?: { titulo?: string; titulo_defecto?: string; sufijo_titulo?: string; campos?: Record<string, string> };
+  /** Leyenda explícita [color, texto]; si falta se deriva de `clasificar`. */
+  leyenda?: [string, string][];
+  /** Relleno rayado SVG (p. ej. Parque Nacional). La capa usa fillColor: 'url(#<id>)'. */
+  patron?: {
+    id: string;
+    color: string;
+    separacion?: number;
+    grosor?: number;
+    fondo?: string;
+    opacidad_fondo?: number;
+    opacidad?: number;
+  };
+}
+
+export interface BaseMap {
+  id: string;
+  titulo: string;
+  url: string;
+  atribucion: string;
+  maxZoom?: number;
+  maxNativeZoom?: number;
+  defecto?: boolean;
+}
+
+export interface LayerGroupDef {
+  id: string;
+  titulo: string;
+  capas: ManifestLayer[];
+}
+
+export interface LayersManifest {
+  version: number;
+  titulo?: string;
+  generado?: string;
+  mapas_base?: BaseMap[];
+  /** Encuadres rápidos (botones «Ir a»). */
+  islas?: Record<string, { bounds: LatLngBoundsExpression }>;
+  grupos: LayerGroupDef[];
+}
+
+export interface LegendEntry {
+  color?: string;
+  texto?: string;
+  forma: 'area' | 'linea' | 'punto';
+  simbolo?: string;
+  dash?: string;
+}
+
+/** Clase de leyenda que corresponde a las propiedades de un elemento (o null). */
+export function classFor(layer: ManifestLayer, props: Props | null | undefined): LayerClass | null {
+  const c = layer.clasificar;
+  if (!c) return null;
+  const v = props?.[c.propiedad];
+  if (c.rangos) return c.rangos.find((r) => (Number(v) || 0) <= (r.hasta ?? Infinity)) ?? null;
+  return c.valores?.[String(v)] ?? c.otro ?? null;
+}
+
+function matches(rule: StyleRule, props: Props | null | undefined): boolean {
+  const v = props?.[rule.propiedad];
+  if (rule.igual_a !== undefined) return v === rule.igual_a;
+  if (rule.distinto_de !== undefined) return v !== rule.distinto_de;
+  return false;
+}
+
+/** Opciones de Leaflet para un elemento: estilo base + clase + reglas. */
+export function styleFor(layer: ManifestLayer, props: Props | null | undefined): PathOptions & { radius?: number } {
+  const cls = classFor(layer, props) ?? {};
+  const k: LayerClass = { ...cls };
+  delete k.etiqueta;
+  delete k.simbolo;
+  delete k.hasta;
+  let s: PathOptions & { radius?: number } = { ...layer.estilo, ...k };
+  for (const r of layer.estilo_si ?? []) if (matches(r, props)) s = { ...s, ...r.estilo };
+  return s;
+}
+
+/** Entradas de leyenda de una capa. */
+export function legendFor(layer: ManifestLayer): LegendEntry[] {
+  if (layer.leyenda) return layer.leyenda.map(([color, texto]) => ({ color, texto, forma: 'area' }));
+  const forma: LegendEntry['forma'] = layer.tipo === 'linea' ? 'linea' : layer.tipo === 'punto' ? 'punto' : 'area';
+  const c = layer.clasificar;
+  const items: LayerClass[] = c
+    ? [...(c.rangos ?? Object.values(c.valores ?? {})), ...(c.otro ? [c.otro] : [])]
+    : [{ etiqueta: layer.titulo }];
+  const out: LegendEntry[] = items.map((it) => {
+    const s = { ...layer.estilo, ...it };
+    const color = forma === 'linea' ? s.color : (s.fillColor ?? s.color);
+    const e: LegendEntry = { forma };
+    if (color) e.color = color;
+    if (it.etiqueta) e.texto = it.etiqueta;
+    if (it.simbolo) e.simbolo = it.simbolo;
+    if (typeof s.dashArray === 'string') e.dash = s.dashArray;
+    return e;
+  });
+  for (const r of layer.estilo_si ?? []) {
+    if (!r.etiqueta) continue;
+    const e: LegendEntry = { color: '#6b7280', texto: r.etiqueta, forma: 'linea' };
+    if (typeof r.estilo.dashArray === 'string') e.dash = r.estilo.dashArray;
+    out.push(e);
+  }
+  return out;
+}
+
+export function escapeHtml(s: unknown): string {
+  return String(s ?? '').replace(
+    /[&<>"']/g,
+    (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c,
+  );
+}
+
+const NUM = new Intl.NumberFormat('es');
+
+function formatValue(v: unknown): string {
+  if (v === true) return 'Sí';
+  if (v === false) return 'No';
+  if (typeof v === 'number') return NUM.format(v);
+  return String(v);
+}
+
+/** HTML (escapado) del popup de un elemento según `layer.popup`. */
+export function popupHtml(layer: ManifestLayer, props: Props): string {
+  const p = layer.popup ?? {};
+  const cls = classFor(layer, props);
+  const raw = p.titulo ? props[p.titulo] : undefined;
+  const title = raw != null && raw !== '' ? `${String(raw)}${p.sufijo_titulo ?? ''}` : (p.titulo_defecto ?? layer.titulo);
+  const sub = cls?.etiqueta && cls.etiqueta !== title ? `${cls.etiqueta} · ` : '';
+  let h = `<div style="font-size:12.5px;min-width:180px"><div style="font-weight:650;font-size:13.5px">${escapeHtml(title)}</div>`;
+  h += `<div style="font-size:11px;color:#777;margin-bottom:6px">${escapeHtml(sub)}${escapeHtml(layer.titulo)}</div><table>`;
+  for (const [k, label] of Object.entries(p.campos ?? {})) {
+    const v = props[k];
+    if (v == null || v === '') continue;
+    h += `<tr><td style="color:#777;padding:1px 8px 1px 0;vertical-align:top">${escapeHtml(label)}</td><td>${escapeHtml(formatValue(v))}</td></tr>`;
+  }
+  return `${h}</table></div>`;
+}
+
+/** URL de un archivo del paquete: relativa a la base del manifiesto salvo que sea absoluta. */
+export function resolveUrl(base: string, file: string): string {
+  if (/^(https?:)?\//.test(file)) return file;
+  return (base.endsWith('/') ? base : `${base}/`) + file;
+}
+
+/** Estado inicial de visibilidad: { idCapa: visible }. */
+export function defaultVisibility(manifest: LayersManifest): Record<string, boolean> {
+  const out: Record<string, boolean> = {};
+  for (const g of manifest.grupos) for (const c of g.capas) out[c.id] = Boolean(c.visible);
+  return out;
+}
+
+/** ¿Se debe dibujar la capa con este zoom? */
+export function isDrawable(layer: ManifestLayer, on: boolean, zoom: number): boolean {
+  return on && !(layer.zoom_min != null && zoom < layer.zoom_min);
+}
